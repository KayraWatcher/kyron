# altinapi.com PoC Configuration
# Copy this file to .env and fill in your API key

# altinapi.com API Key (from Dashboard, format: hapi_...)
# Get from: https://altinapi.com/dashboard → API Anahtarı
# IMPORTANT: WebSocket requires Pro+ plan (Free trial = REST only, no WebSocket)
# Pro: 60 req/min + 3 WS | Enterprise: 60 req/min + 10 WS
# Free trial: 1000 req/month REST ONLY, NO WebSocket
ALTINAPI_API_KEY=your_hapi_api_key_here