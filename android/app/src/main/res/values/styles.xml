<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting.
         KYRON splash: koyu zemin + logo (gunduz modu; tasarim moda bagli degil). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         windowBackground bilerek splash zeminiyle ayni koyu renktir: sistem
         splash'i -> pencere -> Flutter ilk kare gecisinde ekran firlamasi olmasin. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/kyron_splash_bg</item>
    </style>
</resources>
