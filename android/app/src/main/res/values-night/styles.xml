<resources>
    <!-- Dikkat: LaunchTheme burada TANIMLANMAZ. Splash tasarimi moda bagli
         degildir (koyu zemin + logo); gece modunda da values/veya values-v31/
         dosyalarindaki LaunchTheme kullanilir. Bu, Android 12+ (values-v31)
         splash niteliklerinin gece modunda golgelenmesini engeller. -->

    <!-- Theme applied to the Android Window as soon as the process has started
         (Dark Mode acik). windowBackground splash zeminiyle ayni koyu renk. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/kyron_splash_bg</item>
    </style>
</resources>
